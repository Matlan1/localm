# Keep shell scripts LF so they run on Linux/macOS regardless of git autocrlf.
*.sh text eol=lf
# Windows batch files must stay CRLF.
*.bat text eol=crlf

# ARCH-07 rag store fixture: byte-exact on every platform.
tests/fixtures/rag_store_v1/** -text

# Rerank evaluation corpus: chunk boundaries (and the recorded replay) depend on the line endings.
tests/fixtures/rag_rerank_eval/corpus/** text eol=lf
